{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "router": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "enum": ["cache_aware", "round_robin", "power_of_two", "manual", "random", "prefix_hash"]
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "replicas": { "type": "integer", "minimum": 1 },
        "progressDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "discovery": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": ["", "kubernetes", "file", "slurm", "consul"]
            },
            "checkIntervalSecs": { "type": ["integer", "null"], "minimum": 1 },
            "kubernetes": {
              "type": "object",
              "properties": {
                "clusterWide": { "type": "boolean" },
                "namespace": { "type": "string" },
                "selector": { "type": "string" },
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "modelIdFrom": { "type": "string" }
              }
            },
            "file": {
              "type": "object",
              "properties": {
                "configMap": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "key": { "type": "string" }
                  }
                },
                "path": { "type": "string" }
              }
            },
            "slurm": {
              "type": "object",
              "properties": {
                "jobNames": { "type": "array", "items": { "type": "string" } },
                "encodeJobNames": { "type": "array", "items": { "type": "string" } },
                "prefillJobNames": { "type": "array", "items": { "type": "string" } },
                "decodeJobNames": { "type": "array", "items": { "type": "string" } },
                "port": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
                "bootstrapPort": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
                "user": { "type": "string" },
                "account": { "type": "string" },
                "partition": { "type": "string" }
              }
            },
            "consul": {
              "type": "object",
              "properties": {
                "service": { "type": "string" },
                "address": { "type": "string" },
                "datacenter": { "type": "string" },
                "token": {
                  "type": "object",
                  "properties": {
                    "existingSecret": { "type": "string" },
                    "secretKey": { "type": "string" }
                  }
                },
                "tls": {
                  "type": "object",
                  "properties": {
                    "existingSecret": { "type": "string" },
                    "secretKeys": {
                      "type": "object",
                      "properties": {
                        "caCert": { "type": "string" },
                        "clientCert": { "type": "string" },
                        "clientKey": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "metrics": {
          "type": "object",
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 },
            "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "rateLimitTokensPerSecond": { "type": "integer" }
      }
    },
    "history": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "enum": ["none", "memory", "postgres", "redis", "oracle"]
        },
        "postgres": {
          "type": "object",
          "properties": {
            "url": { "type": "string" },
            "existingSecret": { "type": "string" },
            "secretKey": { "type": "string" },
            "poolMax": { "type": "integer", "minimum": 1 }
          }
        },
        "redis": {
          "type": "object",
          "properties": {
            "url": { "type": "string" },
            "existingSecret": { "type": "string" },
            "secretKey": { "type": "string" },
            "poolMax": { "type": "integer", "minimum": 1 }
          }
        },
        "oracle": {
          "type": "object",
          "properties": {
            "dsn": { "type": "string" },
            "user": { "type": "string" },
            "password": { "type": "string" },
            "existingSecret": { "type": "string" },
            "secretKeys": {
              "type": "object",
              "properties": {
                "dsn": { "type": "string" },
                "user": { "type": "string" },
                "password": { "type": "string" }
              }
            },
            "poolMax": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
