+def _dequant_gfx942_gptoss_weight(weight, scale):
+    # Reuse the existing original-MXFP4 decoder, not a new quantizer/checkpoint.
+    from sglang.srt.layers.quantization.fp8_utils import dequant_mxfp4
+
+    if (
+        weight.dtype != torch.uint8
+        or scale.dtype != torch.uint8
+        or weight.ndim != 3
+        or scale.ndim != 3
+    ):
+        raise ValueError("Expected original uint8 packed MXFP4 expert weight and scale")
+    e, n, packed = weight.shape
+    if (
+        e == 0
+        or n == 0
+        or packed == 0
+        or packed % 16
+        or tuple(scale.shape) != (e, n, packed // 16)
+    ):
+        raise ValueError("Original MXFP4 expert weight/scale block layout mismatch")
+    result = dequant_mxfp4(
+        weight.reshape(e, n, packed // 16, 16), scale, torch.bfloat16
+    )
