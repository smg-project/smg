#!/bin/bash
# A stand-in for the docker client: `docker ps` lists the lines of
# $FAKE_SMI_STATE/containers (none when the file is absent).
case "$1" in
    ps) [ -f "${FAKE_SMI_STATE:?}/containers" ] && cat "$FAKE_SMI_STATE/containers"; exit 0 ;;
    *) echo "fake docker: unsupported arguments: $*" >&2; exit 2 ;;
esac
